{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KALBfBKudvy6BqngAEwesN","type":"tool_result","content":"\"\"\"Every request and response model for /api/v1.\n\nThis module is the machine-readable form of 01-BACKEND-BRIEF.md §4–§11. The\nfrontend generates its TypeScript from the OpenAPI schema these produce\n(frontend brief §4.1), so a field renamed here is a breaking change and a\nfield added as required here breaks their build.\n\nTwo rules that are enforced rather than hoped for:\n\n- `data/fixtures/*.json` is generated by instantiating these models\n  (scripts/gen_fixtures.py), so a fixture cannot drift from the response shape.\n  tests/test_schemas.py validates every fixture back through its model.\n- No `dict[str, Any]` on a request body. Brief §13 requires explicit types,\n  bounds and enums on every public input.\n\nField order follows the brief's JSON examples so the two read side by side.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport uuid\nfrom datetime import datetime\nfrom typing import Annotated, Generic, Literal, TypeVar\n\nfrom pydantic import BaseModel, ConfigDict, EmailStr, Field, StringConstraints\n\nfrom db.models import DocSource, Resolver, RoutingBucket, UserRole\n\n# ── shared ───────────────────────────────────────────────────────────────────\n\nT = TypeVar(\"T\")\n\nUnit = Annotated[float, Field(ge=0.0, le=1.0)]\n\"\"\"A score the API promises is in [0,1]. Matches the DB CHECK constraints.\"\"\"\n\nShortText = Annotated[str, StringConstraints(min_length=1, max_length=512, strip_whitespace=True)]\n\n\nclass Schema(BaseModel):\n    \"\"\"Base for every model here.\n\n    `extra=\"forbid\"` on requests is what turns a typo in a client payload into\n    a 422 with a field message instead of a silently ignored parameter.\n    \"\"\"\n\n    model_config = ConfigDict(extra=\"forbid\", from_attributes=True)\n\n\nclass PaginationOut(Schema):\n    cursor: str | None = Field(default=None, description=\"The cursor this page was fetched with.\")\n    next_cursor: str | None = Field(default=None, description=\"Pass as `cursor` for the next page.\")\n    has_more: bool\n    limit: int = Field(ge=1, le=100)\n\n\nclass Paginated(Schema, Generic[T]):\n    \"\"\"Brief §3: collections are always wrapped, single resources never are.\"\"\"\n\n    data: list[T]\n    pagination: PaginationOut\n\n\nclass ErrorBody(Schema):\n    code: str\n    message: str\n    status: int\n    request_id: str\n    details: dict[str, object] = Field(default_factory=dict)\n\n\nclass ErrorEnvelope(Schema):\n    \"\"\"Documented in OpenAPI so the frontend can generate its error types too.\"\"\"\n\n    error: ErrorBody\n\n\n# ── auth (§4) ────────────────────────────────────────────────────────────────\n\n\nclass RegisterRequest(Schema):\n    email: EmailStr\n    # Policy is enforced server-side in core.security.validate_password, which\n    # also checks the common-password denylist. The bound here is only the\n    # cheap structural check so an absurd payload never reaches argon2.\n    password: Annotated[str, StringConstraints(min_length=12, max_length=256)]\n    org_name: Annotated[str, StringConstraints(min_length=2, max_length=120, strip_whitespace=True)]\n\n\nclass LoginRequest(Schema):\n    email: EmailStr\n    password: Annotated[str, StringConstraints(min_length=1, max_length=256)]\n\n\nclass UserOut(Schema):\n    id: uuid.UUID\n    email: str\n    role: UserRole\n    org_id: uuid.UUID\n\n\nclass AuthResponse(Schema):\n    \"\"\"The refresh token is NOT here.\n\n    It is set as an HttpOnly cookie and the frontend never touches it\n    (brief §4). Putting it in a JSON body would make it readable by any script\n    on the page, which defeats the point of rotation.\n    \"\"\"\n\n    user: UserOut\n    access_token: str\n    token_type: Literal[\"bearer\"] = \"bearer\"\n    expires_in: int = Field(description=\"Access token lifetime in seconds.\")\n\n\nclass MeResponse(Schema):\n    id: uuid.UUID\n    email: str\n    role: UserRole\n    org_id: uuid.UUID\n    org_name: str\n    # Frontend gates affordances on these strings, never on `role`\n    # (frontend brief §4.4).\n    permissions: list[str]\n\n\n# ── documents (§5) ───────────────────────────────────────────────────────────\n\n\nclass DocumentIngested(Schema):\n    id: uuid.UUID\n    title: str\n    source: DocSource\n    chars: int\n\n\nclass UploadResponse(Schema):\n    job_id: uuid.UUID\n    documents: list[DocumentIngested]\n    duplicates_skipped: int\n\n\nScenario = Literal[\"meridian_shell_ring\", \"clean_baseline\", \"invoice_flood\"]\n\n\nclass SeedRequest(Schema):\n    \"\"\"`train_corpus` is deliberately absent from the enum.\n\n    It is the tagger/GAT training split and must never be servable through the\n    API — an evaluated insight drawn from training data would contaminate every\n    number the project reports.\n    \"\"\"\n\n    scenario: Scenario = \"meridian_shell_ring\"\n\n\nclass MentionOut(Schema):\n    entity_id: uuid.UUID\n    surface: str\n    entity_type: str\n    char_start: int = Field(ge=0)\n    char_end: int = Field(ge=0)\n    tagger_conf: Unit\n\n\nclass SpanOut(Schema):\n    insight_id: uuid.UUID\n    char_start: int = Field(ge=0)\n    char_end: int = Field(ge=0)\n    relation: str\n    confidence: Unit\n    routing: RoutingBucket\n\n\nclass DocumentSummary(Schema):\n    id: uuid.UUID\n    title: str\n    source: DocSource\n    received_at: datetime\n    chars: int\n    insight_count: int\n\n\nclass DocumentDetail(Schema):\n    \"\"\"`raw_text` is the single source of truth for every offset in the system.\n\n    The frontend slices this exact string to render highlights and must not\n    normalize whitespace, trim, or pass it through a markdown renderer\n    (brief §5). It is rendered into `textContent`, never `innerHTML`.\n    \"\"\"\n\n    id: uuid.UUID\n    title: str\n    source: DocSource\n    received_at: datetime\n    raw_text: str\n    spans: list[SpanOut]\n    mentions: list[MentionOut]\n\n\n# ── ingest (§5) ──────────────────────────────────────────────────────────────\n\n\nJobStateName = Literal[\n    \"queued\", \"tagging\", \"parsing\", \"relating\", \"scoring\", \"routing\", \"done\", \"failed\"\n]\n\n\nclass StageProgress(Schema):\n    tagging: Unit = 0.0\n    parsing: Unit = 0.0\n    relating: Unit = 0.0\n    scoring: Unit = 0.0\n    routing: Unit = 0.0\n\n\nclass JobOut(Schema):\n    id: uuid.UUID\n    state: JobStateName\n    docs_total: int\n    docs_done: int\n    insights_found: int\n    stage_progress: StageProgress\n    started_at: datetime | None = None\n    finished_at: datetime | None = None\n    error: str | None = None\n\n\n# ── insights (§6) ────────────────────────────────────────────────────────────\n\n\nclass EntityRef(Schema):\n    id: uuid.UUID\n    canonical: str\n    entity_type: str\n\n\nclass Citation(Schema):\n    document_id: uuid.UUID\n    document_title: str\n    char_start: int = Field(ge=0)","is_error":false}]},"parent_tool_use_id":null,"session_id":"801c1681-9030-48f6-83eb-54854a27b9d4","uuid":"cb407455-66a5-4524-b9db-629f41563d3f","timestamp":"2026-09-19T18:24:37.207Z","tool_use_result":{"stdout":"\"\"\"Every request and response model for /api/v1.\n\nThis module is the machine-readable form of 01-BACKEND-BRIEF.md §4–§11. The\nfrontend generates its TypeScript from the OpenAPI schema these produce\n(frontend brief §4.1), so a field renamed here is a breaking change and a\nfield added as required here breaks their build.\n\nTwo rules that are enforced rather than hoped for:\n\n- `data/fixtures/*.json` is generated by instantiating these models\n  (scripts/gen_fixtures.py), so a fixture cannot drift from the response shape.\n  tests/test_schemas.py validates every fixture back through its model.\n- No `dict[str, Any]` on a request body. Brief §13 requires explicit types,\n  bounds and enums on every public input.\n\nField order follows the brief's JSON examples so the two read side by side.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport uuid\nfrom datetime import datetime\nfrom typing import Annotated, Generic, Literal, TypeVar\n\nfrom pydantic import BaseModel, ConfigDict, EmailStr, Field, StringConstraints\n\nfrom db.models import DocSource, Resolver, RoutingBucket, UserRole\n\n# ── shared ───────────────────────────────────────────────────────────────────\n\nT = TypeVar(\"T\")\n\nUnit = Annotated[float, Field(ge=0.0, le=1.0)]\n\"\"\"A score the API promises is in [0,1]. Matches the DB CHECK constraints.\"\"\"\n\nShortText = Annotated[str, StringConstraints(min_length=1, max_length=512, strip_whitespace=True)]\n\n\nclass Schema(BaseModel):\n    \"\"\"Base for every model here.\n\n    `extra=\"forbid\"` on requests is what turns a typo in a client payload into\n    a 422 with a field message instead of a silently ignored parameter.\n    \"\"\"\n\n    model_config = ConfigDict(extra=\"forbid\", from_attributes=True)\n\n\nclass PaginationOut(Schema):\n    cursor: str | None = Field(default=None, description=\"The cursor this page was fetched with.\")\n    next_cursor: str | None = Field(default=None, description=\"Pass as `cursor` for the next page.\")\n    has_more: bool\n    limit: int = Field(ge=1, le=100)\n\n\nclass Paginated(Schema, Generic[T]):\n    \"\"\"Brief §3: collections are always wrapped, single resources never are.\"\"\"\n\n    data: list[T]\n    pagination: PaginationOut\n\n\nclass ErrorBody(Schema):\n    code: str\n    message: str\n    status: int\n    request_id: str\n    details: dict[str, object] = Field(default_factory=dict)\n\n\nclass ErrorEnvelope(Schema):\n    \"\"\"Documented in OpenAPI so the frontend can generate its error types too.\"\"\"\n\n    error: ErrorBody\n\n\n# ── auth (§4) ────────────────────────────────────────────────────────────────\n\n\nclass RegisterRequest(Schema):\n    email: EmailStr\n    # Policy is enforced server-side in core.security.validate_password, which\n    # also checks the common-password denylist. The bound here is only the\n    # cheap structural check so an absurd payload never reaches argon2.\n    password: Annotated[str, StringConstraints(min_length=12, max_length=256)]\n    org_name: Annotated[str, StringConstraints(min_length=2, max_length=120, strip_whitespace=True)]\n\n\nclass LoginRequest(Schema):\n    email: EmailStr\n    password: Annotated[str, StringConstraints(min_length=1, max_length=256)]\n\n\nclass UserOut(Schema):\n    id: uuid.UUID\n    email: str\n    role: UserRole\n    org_id: uuid.UUID\n\n\nclass AuthResponse(Schema):\n    \"\"\"The refresh token is NOT here.\n\n    It is set as an HttpOnly cookie and the frontend never touches it\n    (brief §4). Putting it in a JSON body would make it readable by any script\n    on the page, which defeats the point of rotation.\n    \"\"\"\n\n    user: UserOut\n    access_token: str\n    token_type: Literal[\"bearer\"] = \"bearer\"\n    expires_in: int = Field(description=\"Access token lifetime in seconds.\")\n\n\nclass MeResponse(Schema):\n    id: uuid.UUID\n    email: str\n    role: UserRole\n    org_id: uuid.UUID\n    org_name: str\n    # Frontend gates affordances on these strings, never on `role`\n    # (frontend brief §4.4).\n    permissions: list[str]\n\n\n# ── documents (§5) ───────────────────────────────────────────────────────────\n\n\nclass DocumentIngested(Schema):\n    id: uuid.UUID\n    title: str\n    source: DocSource\n    chars: int\n\n\nclass UploadResponse(Schema):\n    job_id: uuid.UUID\n    documents: list[DocumentIngested]\n    duplicates_skipped: int\n\n\nScenario = Literal[\"meridian_shell_ring\", \"clean_baseline\", \"invoice_flood\"]\n\n\nclass SeedRequest(Schema):\n    \"\"\"`train_corpus` is deliberately absent from the enum.\n\n    It is the tagger/GAT training split and must never be servable through the\n    API — an evaluated insight drawn from training data would contaminate every\n    number the project reports.\n    \"\"\"\n\n    scenario: Scenario = \"meridian_shell_ring\"\n\n\nclass MentionOut(Schema):\n    entity_id: uuid.UUID\n    surface: str\n    entity_type: str\n    char_start: int = Field(ge=0)\n    char_end: int = Field(ge=0)\n    tagger_conf: Unit\n\n\nclass SpanOut(Schema):\n    insight_id: uuid.UUID\n    char_start: int = Field(ge=0)\n    char_end: int = Field(ge=0)\n    relation: str\n    confidence: Unit\n    routing: RoutingBucket\n\n\nclass DocumentSummary(Schema):\n    id: uuid.UUID\n    title: str\n    source: DocSource\n    received_at: datetime\n    chars: int\n    insight_count: int\n\n\nclass DocumentDetail(Schema):\n    \"\"\"`raw_text` is the single source of truth for every offset in the system.\n\n    The frontend slices this exact string to render highlights and must not\n    normalize whitespace, trim, or pass it through a markdown renderer\n    (brief §5). It is rendered into `textContent`, never `innerHTML`.\n    \"\"\"\n\n    id: uuid.UUID\n    title: str\n    source: DocSource\n    received_at: datetime\n    raw_text: str\n    spans: list[SpanOut]\n    mentions: list[MentionOut]\n\n\n# ── ingest (§5) ──────────────────────────────────────────────────────────────\n\n\nJobStateName = Literal[\n    \"queued\", \"tagging\", \"parsing\", \"relating\", \"scoring\", \"routing\", \"done\", \"failed\"\n]\n\n\nclass StageProgress(Schema):\n    tagging: Unit = 0.0\n    parsing: Unit = 0.0\n    relating: Unit = 0.0\n    scoring: Unit = 0.0\n    routing: Unit = 0.0\n\n\nclass JobOut(Schema):\n    id: uuid.UUID\n    state: JobStateName\n    docs_total: int\n    docs_done: int\n    insights_found: int\n    stage_progress: StageProgress\n    started_at: datetime | None = None\n    finished_at: datetime | None = None\n    error: str | None = None\n\n\n# ── insights (§6) ────────────────────────────────────────────────────────────\n\n\nclass EntityRef(Schema):\n    id: uuid.UUID\n    canonical: str\n    entity_type: str\n\n\nclass Citation(Schema):\n    document_id: uuid.UUID\n    document_title: str\n    char_start: int = Field(ge=0)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CfDGQjAbM8BaLug7poA3z","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VFG64WXPx2nRNG2ZorP7dQ","name":"Bash","input":{"command":"cd \"/Users/fuzzdot/Desktop/The HUB/Development/Countersign/backend\" && sed -n '240,710p' api/v1/schemas.py","description":"Read schemas part 2"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7160,"cache_read_input_tokens":84582,"cache_creation":{"ephemeral_5m_input_tokens":7160,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"801c1681-9030-48f6-83eb-54854a27b9d4","uuid":"9b983923-b336-4b9f-a687-5fdd5c58dd7d","timestamp":"2026-09-19T18:24:39.936Z","request_id":"req_011CfDGQifZpTU9hd4jFXzeR","wire_tool_inputs":{"toolu_01VFG64WXPx2nRNG2ZorP7dQ":{"command":"cd \"/Users/fuzzdot/Desktop/The HUB/Development/Countersign/backend\" && sed -n '240,710p' api/v1/schemas.py","description":"Read schemas part 2"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VFG64WXPx2nRNG2ZorP7dQ","type":"tool_result","content":"    char_start: int = Field(ge=0)\n    char_end: int = Field(ge=0)\n    sentence_text: str\n\n\nclass TrustScores(Schema):\n    confidence: Unit\n    vacuity: Unit\n    dissonance: Unit\n    # Null until the fuzzer job has run. Null is not zero — zero would claim\n    # the insight was tested and found robust.\n    fragility: Unit | None = None\n\n\nclass NemotronInfo(Schema):\n    run_id: uuid.UUID\n    rationale: str\n    latency_ms: int\n\n\nclass InsightOut(Schema):\n    id: uuid.UUID\n    relation: str\n    subject: EntityRef\n    object: EntityRef\n    citation: Citation\n    trust: TrustScores\n    routing: RoutingBucket\n    resolved_by: Resolver\n    nemotron: NemotronInfo | None = None\n    # True when the cascade gated this insight for escalation but the upstream\n    # hard-failed, so the classical decision stands. Frontend renders a\n    # \"reviewed classically\" marker (frontend brief §4.3).\n    degraded: bool = False\n    attention_available: bool\n    created_at: datetime\n\n\nclass AttentionEdge(Schema):\n    edge_id: str\n    src_token: str\n    dst_token: str\n    weight: Unit\n    src_idx: int = Field(ge=0)\n    dst_idx: int = Field(ge=0)\n\n\nclass GraphNeighborhood(Schema):\n    node_ids: list[uuid.UUID]\n    depth: int = Field(ge=1, le=3)\n\n\nclass AblationHistoryItem(Schema):\n    id: uuid.UUID\n    masked_edges: list[str]\n    confidence_before: Unit\n    confidence_after: Unit\n    load_bearing: bool\n    created_at: datetime\n\n\nclass FragilityTrialOut(Schema):\n    perturbation: Literal[\"synonym\", \"rename\", \"boilerplate\", \"reorder\", \"punctuation\"]\n    label_flipped: bool\n    conf_delta: float = Field(ge=-1.0, le=1.0)\n    relation_lost: bool\n\n\nclass InsightDetail(InsightOut):\n    attention: list[AttentionEdge]\n    tokens: list[str]\n    graph_neighborhood: GraphNeighborhood\n    ablation_history: list[AblationHistoryItem]\n    fragility_trials: list[FragilityTrialOut]\n\n\nclass InsightStats(Schema):\n    total: int\n    by_routing: dict[str, int]\n    by_resolver: dict[str, int]\n    mean_confidence: Unit\n    high_vacuity_count: int\n    documents_ingested: int\n\n\n# ── graph (§7) ───────────────────────────────────────────────────────────────\n\n\nclass GraphNode(Schema):\n    id: uuid.UUID\n    canonical: str\n    entity_type: str\n    mention_count: int\n    degree: int\n    # Normalized composite of degree centrality, cycle participation and mean\n    # incident-edge routing severity. Weights are in config and reported so the\n    # number is not magic.\n    risk: Unit\n    flags: list[str]\n\n\nclass GraphEdge(Schema):\n    id: uuid.UUID\n    source: uuid.UUID\n    target: uuid.UUID\n    relation: str\n    confidence: Unit\n    vacuity: Unit\n    routing: RoutingBucket\n    insight_ids: list[uuid.UUID]\n    # Number of distinct insights supporting this relation. Drives stroke width.\n    weight: int = Field(ge=1)\n\n\nclass GraphCycle(Schema):\n    node_ids: list[uuid.UUID]\n    length: int = Field(ge=2)\n    relation: str\n    risk: Unit\n\n\nclass GraphResponse(Schema):\n    \"\"\"Cycles are computed server-side via Tarjan SCC over the OWNED_BY\n    subgraph. The frontend must not attempt client-side cycle detection\n    (frontend brief §9); it renders what is here.\"\"\"\n\n    nodes: list[GraphNode]\n    edges: list[GraphEdge]\n    cycles: list[GraphCycle]\n    truncated: bool\n\n\nclass NeighborOut(Schema):\n    entity: GraphNode\n    relation: str\n    direction: Literal[\"in\", \"out\"]\n    confidence: Unit\n    insight_ids: list[uuid.UUID]\n\n\nclass EntityDocument(Schema):\n    id: uuid.UUID\n    title: str\n    mention_count: int\n\n\nclass EntityDetailNode(GraphNode):\n    first_seen: datetime\n\n\nclass EntityDetail(Schema):\n    entity: EntityDetailNode\n    aliases: list[str]\n    neighbors: list[NeighborOut]\n    documents: list[EntityDocument]\n    insight_count: int\n\n\n# ── ablation (§8) ────────────────────────────────────────────────────────────\n\n\nclass AblationRequest(Schema):\n    masked_edges: Annotated[list[str], Field(min_length=1, max_length=32)]\n    # `zero` sets the attention weight to 0 and renormalizes; `uniform`\n    # replaces surviving weights with uniform attention.\n    mode: Literal[\"zero\", \"uniform\"] = \"zero\"\n\n\nclass AblationState(Schema):\n    confidence: Unit\n    vacuity: Unit\n    routing: RoutingBucket\n    relation: str\n\n\nclass AblationDelta(Schema):\n    confidence: float = Field(ge=-1.0, le=1.0)\n    vacuity: float = Field(ge=-1.0, le=1.0)\n    routing_changed: bool\n\n\nclass AblationResponse(Schema):\n    run_id: uuid.UUID\n    insight_id: uuid.UUID\n    masked_edges: list[str]\n    before: AblationState\n    after: AblationState\n    delta: AblationDelta\n    # True iff |delta.confidence| > 0.10 OR routing changed.\n    load_bearing: bool\n    # Template-filled, NOT generated text. Templates live in\n    # ml/ablation/templates.py and the voice layer reads this field verbatim,\n    # so it is part of the no-hallucination guarantee (brief §8).\n    interpretation: str\n    latency_ms: int\n\n\n# ── routing / cascade (§9) ───────────────────────────────────────────────────\n\n\nclass GateConfig(Schema):\n    vacuity_threshold: Unit\n    policy: str\n\n\nclass CascadeVolume(Schema):\n    total_insights: int\n    handled_classically: int\n    escalated_to_nemotron: int\n    escalation_rate: Unit\n    llm_calls_avoided: int\n\n\nclass CascadeLatency(Schema):\n    classical_p50_ms: int\n    classical_p95_ms: int\n    nemotron_p50_ms: int\n    nemotron_p95_ms: int\n\n\nclass CascadeAgreement(Schema):\n    nemotron_upheld_classical: int\n    nemotron_overrode_classical: int\n    override_rate: Unit\n\n\nclass RoutingSummary(Schema):\n    gate: GateConfig\n    volume: CascadeVolume\n    latency: CascadeLatency\n    agreement: CascadeAgreement\n    distribution: dict[str, int]\n\n\nclass NemotronRunOut(Schema):\n    \"\"\"The \"show your work\" table. Brief §14: this is what the Beyond the\n    Chatbot judges will actually want to look at.\"\"\"\n\n    id: uuid.UUID\n    insight_id: uuid.UUID | None\n    prompt_sha: str = Field(min_length=64, max_length=64)\n    decision: RoutingBucket\n    rationale: str\n    latency_ms: int\n    input_tokens: int | None = None\n    output_tokens: int | None = None\n    degraded: bool = False\n    created_at: datetime\n\n\n# ── evals (§10) ──────────────────────────────────────────────────────────────\n\n\nclass Correlation(Schema):\n    spearman: float = Field(ge=-1.0, le=1.0)\n    pearson: float = Field(ge=-1.0, le=1.0)\n    p_value: float = Field(ge=0.0, le=1.0)\n\n\nclass ScatterPoint(Schema):\n    insight_id: uuid.UUID\n    vacuity: Unit\n    fragility: Unit\n    routing: RoutingBucket\n\n\nclass PerturbationStat(Schema):\n    perturbation: str\n    flip_rate: Unit\n    mean_abs_conf_delta: Unit\n    relation_loss_rate: Unit\n\n\nclass QuartileRow(Schema):\n    vacuity_quartile: int = Field(ge=1, le=4)\n    vacuity_range: tuple[Unit, Unit]\n    mean_fragility: Unit\n    flip_rate: Unit\n\n\nclass FragilityEval(Schema):\n    \"\"\"Brief §10: the single most important response object in the project.\n\n    Whatever the Spearman comes out as is what this returns. There is no code\n    path in the fuzzer that tunes it.\n    \"\"\"\n\n    n_insights: int\n    n_trials: int\n    perturbations: list[str]\n    correlation: Correlation\n    scatter: list[ScatterPoint]\n    by_perturbation: list[PerturbationStat]\n    quartile_table: list[QuartileRow]\n    interpretation: str\n\n\nclass ConfusionMatrix(Schema):\n    labels: list[str]\n    matrix: list[list[int]]\n\n\nclass PerClassMetrics(Schema):\n    bucket: RoutingBucket\n    precision: Unit\n    recall: Unit\n    f1: Unit\n    support: int\n\n\nclass CascadeBaseline(Schema):\n    classical_only_accuracy: Unit\n    nemotron_on_everything_accuracy: Unit\n    cascade_accuracy: Unit\n    cascade_llm_calls: int\n    nemotron_on_everything_llm_calls: int\n    interpretation: str\n\n\nclass DocumentedFailure(Schema):\n    \"\"\"`note` is written by hand and is worth more to the Nemotron judges than\n    every clean metric above it. This list never ships empty (brief §10).\"\"\"\n\n    case_id: uuid.UUID\n    insight_id: uuid.UUID | None\n    ground_truth: RoutingBucket\n    predicted: RoutingBucket\n    sentence_text: str\n    note: str\n\n\nclass RoutingEval(Schema):\n    n_cases: int\n    confusion_matrix: ConfusionMatrix\n    per_class: list[PerClassMetrics]\n    macro_f1: Unit\n    accuracy: Unit\n    cascade_baseline: CascadeBaseline\n    documented_failures: list[DocumentedFailure]\n\n\nclass CalibrationBin(Schema):\n    bin_lo: Unit\n    bin_hi: Unit\n    avg_conf: Unit\n    accuracy: Unit\n    count: int\n\n\nclass CalibrationSnapshotOut(Schema):\n    id: uuid.UUID\n    label: Literal[\"baseline\", \"post_recalibration\"]\n    temperature: float = Field(gt=0.0)\n    ece: Unit\n    mce: Unit\n    brier: Unit\n    bins: list[CalibrationBin]\n    created_at: datetime\n\n\nclass CalibrationEval(Schema):\n    snapshots: list[CalibrationSnapshotOut]\n    current_snapshot_id: uuid.UUID | None\n    hard_negatives_logged: int\n\n\n# ── calibration (§10) ────────────────────────────────────────────────────────\n\n\nclass RecalibrateRequest(Schema):\n    method: Literal[\"temperature_scaling\"] = \"temperature_scaling\"\n\n\nclass CalibrationMetrics(Schema):\n    temperature: float = Field(gt=0.0)\n    ece: Unit\n    mce: Unit\n    brier: Unit\n    bins: list[CalibrationBin]\n\n\nclass CalibrationImprovement(Schema):\n    ece_absolute: float\n    ece_relative: float\n\n\nclass RecalibrateResponse(Schema):\n    before: CalibrationMetrics\n    after: CalibrationMetrics\n    improvement: CalibrationImprovement\n    n_hard_negatives: int\n    elapsed_ms: int\n    snapshot_id: uuid.UUID\n\n\n# ── voice (§11) ──────────────────────────────────────────────────────────────\n\n\nBriefingScope = Literal[\"flagged\", \"escalated\", \"all_new\"]\n\n\nclass BriefingRequest(Schema):\n    scope: BriefingScope = \"flagged\"\n    max_items: int = Field(default=3, ge=1, le=5)\n    voice_id: ShortText = \"default\"\n\n\nclass TranscriptSegment(Schema):\n    \"\"\"`insight_id` is what drives transcript-to-feed highlight sync, which is\n    the moment that sells the voice track (frontend brief §12.1).\"\"\"\n\n    segment_id: str\n    start_ms: int = Field(ge=0)\n    end_ms: int = Field(ge=0)\n    text: str\n    insight_id: uuid.UUID | None = None\n\n\nclass BriefingResponse(Schema):\n    briefing_id: uuid.UUID\n    audio_url: str\n    duration_ms: int = Field(ge=0)\n    transcript: list[TranscriptSegment]\n    insight_ids: list[uuid.UUID]\n    generated_at: datetime\n    # True when this is the prerecorded fallback rather than live synthesis, so\n    # the frontend can show its honest \"playing recorded briefing\" note.\n    is_fallback: bool = False\n\n\nVoiceIntent = Literal[\n    \"explain_flag\",\n    \"show_source\",\n    \"list_flagged\",\n    \"entity_summary\",\n    \"confidence_query\",\n    \"dismiss\",\n    \"unknown\",\n]\n\n\nclass AskResponse(Schema):\n    \"\"\"`answer_text` is assembled from templates over structured fields plus the\n    cited source sentence. No generative model writes it (brief §11).\"\"\"\n\n    question_id: uuid.UUID\n    heard: str\n    stt_confidence: Unit\n    intent: VoiceIntent\n    resolved_insight_id: uuid.UUID | None\n    answer_text: str\n    citation: Citation | None\n    ablation_run_id: uuid.UUID | None\n    audio_url: str | None\n    duration_ms: int = Field(ge=0)\n\n\n# ── eval job (plan §1.8 — endpoint addition) ─────────────────────────────────\n\n\nclass FuzzerRunResponse(Schema):\n    \"\"\"Fuzzing is a job, not part of ingest.\n\n    Ingest must finish in under 30s for the demo; 214 insights x 5 perturbations\n    is 1,07