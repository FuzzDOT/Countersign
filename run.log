es.py:94:class Binding:\ndata/synth/templates.py:103:def render(\ndata/synth/templates.py:161:SUBJ_ORG = Slot(\"subject\", \"ORG\", \"subject\")\ndata/synth/templates.py:162:OBJ_ORG = Slot(\"object\", \"ORG\", \"object\")\ndata/synth/templates.py:163:SUBJ_PERSON = Slot(\"subject\", \"PERSON\", \"subject\")\ndata/synth/templates.py:164:AMOUNT = Slot(\"amount\", \"MONEY\")\ndata/synth/templates.py:165:DATE = Slot(\"date\", \"DATE\")\ndata/synth/templates.py:166:ACCOUNT = Slot(\"account\", \"ACCOUNT_REF\")\ndata/synth/templates.py:167:TXTYPE = Slot(\"txtype\", \"TRANSACTION_TYPE\")\ndata/synth/templates.py:168:ADDRESS = Slot(\"address\", None)  # real text, no label in the tag set\ndata/synth/templates.py:169:DAYS = Slot(\"days\", None)\ndata/synth/templates.py:553:EXCULPATORY_SENTENCE = (\ndata/synth/templates.py:579:def templates_for(relation: str, band: Band, *, split: str) -> tuple[Template, ...]:\ndata/synth/templates.py:597:def assert_template_coverage() -> None:\ncore/ids.py:25:CS_NAMESPACE = uuid.UUID(\"c0de516e-0000-5000-8000-636f756e7465\")\ncore/ids.py:28:def stable_uuid(kind: str, *parts: str | int) -> uuid.UUID:\ncore/ids.py:42:DEMO_ORG_NAME = \"Meridian Ops\"\ncore/ids.py:43:DEMO_ORG_ID = stable_uuid(\"org\", DEMO_ORG_NAME)\ncore/ids.py:45:DEMO_OWNER_EMAIL = \"ops@meridian.example\"\ncore/ids.py:46:DEMO_OWNER_ID = stable_uuid(\"user\", DEMO_OWNER_EMAIL)\ncore/ids.py:50:CONTROL_ORG_NAME = \"Kestrel Audit\"\ncore/ids.py:51:CONTROL_ORG_ID = stable_uuid(\"org\", CONTROL_ORG_NAME)\ncore/ids.py:52:CONTROL_OWNER_EMAIL = \"audit@kestrel.example\"\ncore/ids.py:53:CONTROL_OWNER_ID = stable_uuid(\"user\", CONTROL_OWNER_EMAIL)\ncore/ids.py:56:def entity_id(org_id: uuid.UUID, canonical: str, entity_type: str) -> uuid.UUID:\ncore/ids.py:60:def document_id(org_id: uuid.UUID, scenario: str, index: int) -> uuid.UUID:\ncore/ids.py:64:def insight_id(document: uuid.UUID, char_start: int, relation: str) -> uuid.UUID:","is_error":false}]},"parent_tool_use_id":null,"session_id"