 PytestDeprecationWarning: The configuration option \"asyncio_default_fixture_loop_scope\" is unset.\nThe event loop scope for asynchronous fixtures will default to the fixture caching scope. Future versions of pytest-asyncio will default the loop scope for asynchronous fixtures to function scope. Set the default fixture loop scope explicitly in order to avoid unexpected behavior in the future. Valid fixture loop scopes are: \"function\", \"class\", \"module\", \"package\", \"session\"\n\n  warnings.warn(PytestDeprecationWarning(_DEFAULT_FIXTURE_LOOP_SCOPE_UNSET))\n........................................................................ [ 22%]\n........................................................................ [ 45%]\n........................................................................ [ 67%]\n........................................................................ [ 90%]\n...............................                                          [100%]\n=============================== warnings summary ===============================\n../usr/local/lib/python3.11/site-packages/starlette/testclient.py:40\n  /usr/local/lib/python3.11/site-packages/starlette/testclient.py:40: DeprecationWarning: The anyio.abc.BlockingPortal alias is deprecated, use anyio.from_thread.BlockingPortal instead.\n    _PortalFactoryType = typing.Callable[[], typing.ContextManager[anyio.abc.BlockingPortal]]\n\n-- Docs: https://docs.pytest.org/en/stable/how-to/capture-warnings.html\n319 passed, 1 warning in 10.59s","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/fuzzdot/Desktop/The HUB/Development/Countersign/run.log","hunks":[{"oldStart":28,"oldLines":3,"newStart":28,"newLines":4,"lines":[" {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01SDZC3syp6G5gNxvXDMFu59\",\"type\":\"tool_result\",\"content\":\"# ── web ──────────────────────────────────────────────────────────────────────\\nfastapi==0.115.6\\nuvicorn[standard]==0.34.0\\npydantic==2.10.4\\n# Required by `EmailStr` in api/v1/schemas.py. Pydantic does NOT pull this in\\n# by default — it imports lazily at model-build time, so a missing install\\n# fails at import of the router rather than at request time. Equivalent to\\n# pydantic[email]; pinned separately so the version is visible.\\nemail-validator==2.2.0\\npydantic-settings==2.7.0\\npython-multipart==0.0.20\\nhttpx==0.28.1\\n\\n# ── database ─────────────────────────────────────────────────────────────────\\nsqlalchemy==2.0.36\\nalembic==1.14.0\\npsycopg[binary,pool]==3.2.3\\npgvector==0.3.6\\n\\n# ── auth / security ──────────────────────────────────────────────────────────\\npyjwt==2.10.1\\nargon2-cffi==23.1.0\\nslowapi==0.1.9\\n\\n# ── ml ───────────────────────────────────────────────────────────────────────\\n# torch is installed separately in the Dockerfile (CPU wheel index).\\ntorch-geometric==2.6.1\\nnumpy==2.2.0\\nscipy==1.14.1\\nscikit-learn==1.6.0\\nspacy==3.8.3\\nnltk==3.9.1\\nxgboost==2.1.3\\n\\n# ── documents ────────────────────────────────────────────────────────────────\\npypdf==5.1.0\\npython-dateutil==2.9.0.post0\\n\\n# ── audio ────────────────────────────────────────────────────────────────────\\nelevenlabs==1.50.3\\n\\n# ── util ─────────────────────────────────────────────────────────────────────\\nstructlog==24.4.0\\ntenacity==9.0.0\\norjson==3.10.12\\nfaker==33.1.0\\n=== DOCKERFILE ===\\n# ──────────────────────────────────────────────────────────────────────────────\\n# COUNTERSIGN backend\\n#\\n# Stages:\\n#   base  — python + system deps, shared by everything\\n#   deps  — installed python packages (cached layer; only busts on lock change)\\n#   dev   — live-reload uvicorn, dev tooling included\\n#   prod  — non-root, no dev tooling, gunicorn/uvicorn workers\\n# ──────────────────────────────────────────────────────────────────────────────\\n\\nFROM python:3.11-slim-bookworm AS base\\n\\nENV PYTHONUNBUFFERED=1 \\\\\\n    PYTHONDONTWRITEBYTECODE=1 \\\\\\n    PIP_NO_CACHE_DIR=1 \\\\\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\\\\n    POETRY_VIRTUALENVS_CREATE=false\\n\\n# libpq for psycopg, build-essential for any wheel that needs compiling,\\n# curl for healthchecks, git because some ML packages want it at install time.\\nRUN apt-get update && apt-get install -y --no-install-recommends \\\\\\n      build-essential \\\\\\n      libpq-dev \\\\\\n      curl \\\\\\n      git \\\\\\n    && rm -rf /var/lib/apt/lists/*\\n\\nWORKDIR /app\\n\\n\\n# ── deps ─────────────────────────────────────────────────────────────────────\\nFROM base AS deps\\n\\nCOPY requirements.txt requirements-dev.txt ./\\n\\n# CPU-only torch. The CUDA wheels are ~2.5GB and we do not need them —\\n# the models here are small and run fine on CPU. If you get a GPU box,\\n# drop the --index-url line.\\nRUN pip install --index-url https://download.pytorch.org/whl/cpu \\\\\\n      torch==2.5.1 \\\\\\n && pip install -r requirements.txt\\n\\n\\n# ── dev ──────────────────────────────────────────────────────────────────────\\nFROM deps AS dev\\n\\nRUN pip install -r requirements-dev.txt\\n# spaCy model is a runtime download; bake it in so first boot is fast.\\nRUN python -m spacy download en_core_web_sm\\n# WordNet, for the adversarial fuzzer's synonym family. nltk.download() at\\n# runtime is a network call, and the fuzzer dying at hour 12 inside a container\\n# with no internet is an avoidable disaster. ~10 MB baked in.\\nRUN python -m nltk.downloader -d /usr/share/nltk_data wordnet omw-1.4\\nENV NLTK_DATA=/usr/share/nltk_data\\n\\nCOPY . .\\n\\nEXPOSE 8000\\nCMD [\\\"uvicorn\\\", \\\"api.main:app\\\", \\\"--host\\\", \\\"0.0.0.0\\\", \\\"--port\\\", \\\"8000\\\", \\\"--reload\\\", \\\"--reload-dir\\\", \\\"/app\\\"]\\n\\n\\n# ── prod ─────────────────────────────────────────────────────────────────────\\nFROM deps AS prod\\n\\nRUN python -m spacy download en_core_web_sm\\nRUN python -m nltk.downloader -d /usr/share/nltk_data wordnet omw-1.4\\nENV NLTK_DATA=/usr/share/nltk_data\\n\\n# Non-root. Do this before COPY so ownership is right in one layer.\\nRUN groupadd --gid 10001 app \\\\\\n && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app\\n\\nCOPY --chown=app:app . .\\n\\n# Writable dirs the app needs at runtime.\\nRUN mkdir -p /app/data/audio /app/data/cache/parses /app/static \\\\\\n && chown -R app:app /app/data /app/static\\n\\nUSER app\\n\\nEXPOSE 8000\\nHEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=5 \\\\\\n  CMD curl -fsS http://localhost:8000/health || exit 1\\n\\n# 2 workers: the ML models are loaded per-worker and each costs memory.\\n# Raise only if you've measured that you're request-bound, not memory-bound.\\nCMD [\\\"uvicorn\\\", \\\"api.main:app\\\", \\\"--host\\\", \\\"0.0.0.0\\\", \\\"--port\\\", \\\"8000\\\", \\\"--workers\\\", \\\"2\\\", \\\"--no-access-log\\\"]\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"801c1681-9030-48f6-83eb-54854a27b9d4\",\"uuid\":\"97982850-4d35-4ea7-8765-4a4e12e772c5\",\"timestamp\":\"2026-09-19T18:23:57.558Z\",\"tool_use_result\":{\"stdout\":\"# ── web ──────────────────────────────────────────────────────────────────────\\nfastapi==0.115.6\\nuvicorn[standard]==0.34.0\\npydantic==2.10.4\\n# Required by `EmailStr` in api/v1/schemas.py. Pydantic does NOT pull this in\\n# by default — it imports lazily at model-build time, so a missing install\\n# fails at import of the router rather than at request time. Equivalent to\\n# pydantic[email]; pinned separately so the version is visible.\\nemail-validator==2.2.0\\npydantic-settings==2.7.0\\npython-multipart==0.0.20\\nhttpx==0.28.1\\n\\n# ── database ─────────────────────────────────────────────────────────────────\\nsqlalchemy==2.0.36\\nalembic==1.14.0\\npsycopg[binary,pool]==3.2.3\\npgvector==0.3.6\\n\\n# ── auth / security ──────────────────────────────────────────────────────────\\npyjwt==2.10.1\\nargon2-cffi==23.1.0\\nslowapi==0.1.9\\n\\n# ── ml ───────────────────────────────────────────────────────────────────────\\n# torch is installed separately in the Dockerfile (CPU wheel index).\\ntorch-geometric==2.6.1\\nnumpy==2.2.0\\nscipy==1.14.1\\nscikit-learn==1.6.0\\nspacy==3.8.3\\nnltk==3.9.1\\nxgboost==2.1.3\\n\\n# ── documents ────────────────────────────────────────────────────────────────\\npypdf==5.1.0\\npython-dateutil==2.9.0.post0\\n\\n# ── audio ────────────────────────────────────────────────────────────────────\\nelevenlabs==1.50.3\\n\\n# ── util ─────────────────────────────────────────────────────────────────────\\nstructlog==24.4.0\\ntenacity==9.0.0\\norjson==3.10.12\\nfaker==33.1.0\\n=== DOCKERFILE ===\\n# ──────────────────────────────────────────────────────────────────────────────\\n# COUNTERSIGN backend\\n#\\n# Stages:\\n#   base  — python + system deps, shared by everything\\n#   deps  — installed python packages (cached layer; only busts on lock change)\\n#   dev   — live-reload uvicorn, dev tooling included\\n#   prod  — non-root, no dev tooling, gunicorn/uvicorn workers\\n# ──────────────────────────────────────────────────────────────────────────────\\n\\nFROM python:3.11-slim-bookworm AS base\\n\\nENV PYTHONUNBUFFERED=1 \\\\\\n    PYTHONDONTWRITEBYTECODE=1 \\\\\\n    PIP_NO_CACHE_DIR=1 \\\\\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\\\\n    POETRY_VIRTUALENVS_CREATE=false\\n\\n# libpq for psycopg, build-essential for any wheel that needs compiling,\\n# curl for healthchecks, git because some ML packages want it at install time.\\nRUN apt-get update && apt-get install -y --no-install-recommends \\\\\\n      build-essential \\\\\\n      libpq-dev \\\\\\n      curl \\\\\\n      git \\\\\\n    && rm -rf /var/lib/apt/lists/*\\n\\nWORKDIR /app\\n\\n\\n# ── deps ─────────────────────────────────────────────────────────────────────\\nFROM base AS deps\\n\\nCOPY requirements.txt requirements-dev.txt ./\\n\\n# CPU-only torch. The CUDA wheels are ~2.5GB and we do not need them —\\n# the models here are small and run fine on CPU. If you get a GPU box,\\n# drop the --index-url line.\\nRUN pip install --index-url https://download.pytorch.org/whl/cpu \\\\\\n      torch==2.5.1 \\\\\\n && pip install -r requirements.txt\\n\\n\\n# ── dev ──────────────────────────────────────────────────────────────────────\\nFROM deps AS dev\\n\\nRUN pip install -r requirements-dev.txt\\n# spaCy model is a runtime download; bake it in so first boot is fast.\\nRUN python -m spacy download en_core_web_sm\\n# WordNet, for the adversarial fuzzer's synonym family. nltk.download() at\\n# runtime is a network call, and the fuzzer dying at hour 12 inside a container\\n# with no internet is an avoidable disaster. ~10 MB baked in.\\nRUN python -m nltk.downloader -d /usr/share/nltk_data wordnet omw-1.4\\nENV NLTK_DATA=/usr/share/nltk_data\\n\\nCOPY . .\\n\\nEXPOSE 8000\\nCMD [\\\"uvicorn\\\", \\\"api.main:app\\\", \\\"--host\\\", \\\"0.0.0.0\\\", \\\"--port\\\", \\\"8000\\\", \\\"--reload\\\", \\\"--reload-dir\\\", \\\"/app\\\"]\\n\\n\\n# ── prod ─────────────────────────────────────────────────────────────────────\\nFROM deps AS prod\\n\\nRUN python -m spacy download en_core_web_sm\\nRUN python -m nltk.downloader -d /usr/share/nltk_data wordnet omw-1.4\\nENV NLTK_DATA=/usr/share/nltk_data\\n\\n# Non-root. Do this before COPY so ownership is right in one layer.\\nRUN groupadd --gid 10001 app \\\\\\n && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app\\n\\nCOPY --chown=app:app . .\\n\\n# Writable dirs the app needs at runtime.\\nRUN mkdir -p /app/data/audio /app/data/cache/parses /app/static \\\\\\n && chown -R app:app /app/data /app/static\\n\\nUSER app\\n\\nEXPOSE 8000\\nHEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=5 \\\\\\n  CMD curl -fsS http://localhost:8000/health || exit 1\\n\\n# 2 workers: the ML models are loaded per-worker and each costs memory.\\n# Raise only if you've measured that you're request-bound, not memory-bound.\\nCMD [\\\"uvicorn\\\", \\\"api.main:app\\\", \\\"--host\\\", \\\"0.0.0.0\\\", \\\"--port\\\", \\\"8000\\\", \\\"--workers\\\", \\\"2\\\", \\\"--no-access-log\\\"]\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5\",\"id\":\"msg_011CfDGMocPyfAzjwBdojH6K\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Containers are up. Let me get a baseline test run and survey the key existing modules.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2816,\"cache_read_input_tokens\":45058,\"cache_creation\":{\"ephemeral_5m_input_tokens\":2816,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"801c1681-9030-48f6-83eb-54854a27b9d4\",\"uuid\":\"f5dea20a-d142-4874-b1d7-e774ca2da165\",\"timestamp\":\"2026-09-19T18:23:59.309Z\",\"request_id\":\"req_011CfDGMoBM6TKKrEuoP8EKT\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5\",\"id\":\"msg_011CfDGMocPyfAzjwBdojH6K\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01SrW19CfRxDoBLRnFpQ7LGH\",\"name\":\"Bash\",\"input\":{\"command\":\"cd \\\"/Users/fuzzdot/Desktop/The HUB/Development/Countersign\\\" && docker compose exec -T backend pytest -q 2>&1 | tail -20\",\"description\":\"Baseline test run\",\"timeout\":600000},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2816,\"cache_read_input_tokens\":45058,\"cache_creation\":{\"ephemeral_5m_input_tokens\":2816,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"801c1681-9030-48f6-83eb-54854a27b9d4\",\"uuid\":\"2ea15df2-d2ab-4ff2-b220-b1b0bb3904e5\",\"timestamp\":\"2026-09-19T18:24:00.519Z\",\"request_id\":\"req_011CfDGMoBM6TKKrEuoP8EKT\",\"wire_tool_inputs\":{\"toolu_01SrW19CfRxDoBLRnFpQ7LGH\":{\"command\":\"cd \\\"/Users/fuzzdot/Desktop/The HUB/Development/Countersign\\\" && docker compose exec -T backend pytest -q 2>&1 | tail -20\",\"description\":\"Baseline test run\",\"timeout\":600000}}}","+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5\",\"id\":\"msg_011CfDGMocPyfAzjwBdojH6K\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01Btbfu4bzowXy26wmS9U7ZB\",\"name\":\"Bash\",\"input\":{\"command\":\"cd \\\"/Users/fuzzdot/Desktop/The HUB/Development/Countersign/backend\\\" && cat api/mock.py\",\"description\":\"Read api/mock.py\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2816,\"cache_read_input_tokens\":45058,\"cache_creation\":{\"ephemeral_5m_input_tokens\":2816,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"801c1681-9030-48f6-83eb-54854a27b9d4\",\"uuid\":\"518b659a-95af-451f-a546-92bc8a3bece1\",\"timestamp\":\"2026-09-19T18:24:01.245Z\",\"request_id\":\"req_011CfDGMoBM6TKKrEuoP8EKT\",\"wire_tool_inputs\":{\"toolu_01Btbfu4bzowXy26wmS9U7ZB\":{\"command\":\"cd \\\"/Users/fuzzdot/Desktop/The HUB/Development/Countersign/backend\\\" && cat api/mock.py\",\"description\":\"Read api/mock.py\"}}}"]}]}],"moreFiles":0,"changedFiles":