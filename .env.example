# ──────────────────────────────────────────────────────────────────────────────
# COUNTERSIGN environment
#
#   cp .env.example .env
#
# Never commit .env. Never put a real secret in this file.
# Generate secrets with:  openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
# Seeds random/numpy/torch and the synthetic generator. Judges re-run things;
# the number on the slide has to be the number on stage.
PIPELINE_SEED=20260919

# ── ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# ── database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=countersign
POSTGRES_PASSWORD=countersign
POSTGRES_DB=countersign
# Overridden inside docker-compose to point at the `db` service host.
DATABASE_URL=postgresql+psycopg://countersign:countersign@localhost:5432/countersign
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false
# A runaway eval aggregation should die, not hold a connection open until the
# demo ends.
DB_STATEMENT_TIMEOUT_MS=15000

# ── auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. 32 bytes hex. The app refuses to start in production without it.
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ISSUER=countersign
JWT_AUDIENCE=countersign-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=cs_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/v1/auth
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Login responses are padded to this duration regardless of which branch ran,
# so the presence of an email is not measurable by timing.
LOGIN_TIMING_TARGET_MS=250
PASSWORD_MIN_LENGTH=12
COMMON_PASSWORDS_PATH=data/common_passwords.txt

# ── cors ─────────────────────────────────────────────────────────────────────
# Explicit origins only. Wildcard is incompatible with credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── upstream services ────────────────────────────────────────────────────────
# Nemotron (NVIDIA). Server-side only; never expose to the browser.
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NEMOTRON_TIMEOUT_SECONDS=6
NEMOTRON_MAX_RETRIES=2
# 28 escalations x 800ms sequential blows the 30s ingest budget on its own.
NEMOTRON_MAX_CONCURRENCY=6
# The citation sentence is the ONLY document-derived text that reaches the
# prompt, and it is truncated to this length. Prompt-injection surface cap.
NEMOTRON_MAX_CITATION_CHARS=400
# Set 1 to force the cascade to fail, to test graceful degradation.
NEMOTRON_FORCE_FAIL=0

# ElevenLabs. Server-side only; never expose to the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_TIMEOUT_SECONDS=8
VOICE_FALLBACK_AUDIO=data/fixtures/audio/fallback_briefing.mp3
# The fallback returns the same JSON shape as a live briefing, transcript and
# all, so degraded mode keeps the transcript-sync demo beat.
VOICE_FALLBACK_TRANSCRIPT=data/fixtures/voice.fallback.json
AUDIO_DIR=data/audio
AUDIO_URL_TTL_SECONDS=600

# ── pipeline tuning ──────────────────────────────────────────────────────────
# gat | rules. Set by the hour-9 decision gate. Both implement edge masking,
# so the ablation endpoint is unaffected by the choice.
RELATION_MODEL=gat
# Tuned by scripts/tune_gate.py to land escalation at 8-20%, not asserted.
VACUITY_GATE_THRESHOLD=0.45
ABLATION_LOAD_BEARING_DELTA=0.10
ENTITY_COREF_THRESHOLD=0.86
CHECKPOINT_DIR=ml/checkpoints
PARSE_CACHE_DIR=data/cache/parses
MAX_UPLOAD_BYTES=2097152
MAX_UPLOAD_FILES=50
# Aggregate cap for a whole multipart request. The per-file cap alone does not
# stop 50 files x 2 MB arriving at once.
MAX_REQUEST_BYTES=110100480
MAX_PDF_PAGES=30
# A 2 MB PDF can extract to far more text than a 2 MB .txt. That asymmetry is
# the real DoS vector, so the char ceiling is separate from the byte cap.
MAX_PDF_CHARS=400000
PDF_TIMEOUT_SECONDS=10

# ── dev / demo switches ──────────────────────────────────────────────────────
# MOCK_MODE=1 serves data/fixtures/* instead of touching the ML pipeline.
# This is how the frontend works before the backend is finished.
MOCK_MODE=0
MOCK_LATENCY_MIN_MS=80
MOCK_LATENCY_MAX_MS=400
MOCK_ERROR_RATE=0.0
FIXTURES_DIR=data/fixtures

LOG_LEVEL=INFO
SERVE_STATIC=false
STATIC_DIR=/app/static

# ── frontend (only VITE_* reaches the browser bundle — treat as public) ──────
VITE_API_BASE_URL=http://localhost:8000/api/v1
